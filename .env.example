# Local-only defaults. Copy to .env and source it before running the API/CLI.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=benchwitness
# Docker host ports; override when running an isolated verification stack.
FALKORDB_BIND_PORT=6379
REDIS_BROKER_BIND_PORT=6380
# Generate with `openssl rand -hex 32` and set the value in your local .env.
BENCHWITNESS_API_TOKEN=
# Audit label recorded for approvals made with this local token.
BENCHWITNESS_APPROVER=local-reviewer
# Dedicated transient RQ broker; never point jobs at FalkorDB.
REDIS_BROKER_HOST=127.0.0.1
REDIS_BROKER_PORT=6380
